# Copy to .env (gitignored) to enable real Street View locally.
# Without these, the game runs on the fixed location list and the placeholder viewer.

# Unrestricted key, used server-side for Street View *metadata* calls (which are free).
# Never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=

# Restricted by HTTP referrer, used by the browser for the panorama viewer. Public by
# nature — the referrer restriction is what protects it.
GOOGLE_MAPS_BROWSER_KEY=

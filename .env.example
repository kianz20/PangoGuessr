# Copy to .env (gitignored) to enable real Street View locally.
# Without these, the game runs on the fixed location list and the placeholder viewer.

# Unrestricted key, used server-side for Street View *metadata* calls (which are free).
# Never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=

# Restricted by HTTP referrer, used by the browser for the panorama viewer. Public by
# nature — the referrer restriction is what protects it.
GOOGLE_MAPS_BROWSER_KEY=

# Enables /admin, the zone editor. Unset means the editor is disabled entirely.
ADMIN_PASSWORD=

# Optional: any Redis-compatible HTTP KV (e.g. Upstash). With these set, zones saved from
# /admin persist across restarts and redeploys. Without them, saves last only as long as
# the server process does.
ZONES_KV_URL=
ZONES_KV_TOKEN=

# Optional alternative to the KV store: a JSON array of zones, applied at boot.
ZONES_JSON=

{
  "name": "@pangoguessr/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js --external:express --external:ws --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/rooms.test.ts test/rounds.test.ts test/sampling.test.ts",
    "smoke": "node test/smoke.mjs",
    "smoke:game": "node test/smoke-game.mjs",
    "check:imagery": "tsx scripts/check-imagery.ts"
  },
  "dependencies": {
    "@pangoguessr/shared": "*",
    "express": "^4.21.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  }
}
